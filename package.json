{
  "name": "qiuzhao-workbench",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "npm ci --prefix desktop",
    "start": "npm start --prefix desktop",
    "test": "npm test --prefix desktop && npm test --prefix hosted-service",
    "test:smoke": "npm run test:smoke --prefix desktop",
    "dashboard": "node dashboard/server.mjs",
    "init:blank": "node tools/init-workspace.cjs blank",
    "init:demo": "node tools/init-workspace.cjs demo",
    "pack": "npm run pack --prefix desktop",
    "dist:win": "npm run dist:win --prefix desktop",
    "dist:mac": "npm run dist:mac --prefix desktop",
    "start:hosted": "npm start --prefix hosted-service",
    "test:hosted": "npm test --prefix hosted-service"
  }
}
