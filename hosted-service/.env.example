# 本机开发默认监听；公网使用 HTTPS 反向代理，不直接暴露裸 HTTP。
HOST=127.0.0.1
PORT=4318
# SERVICE_DATA=/absolute/private/directory
REGISTRATION_INVITE=replace-with-a-long-random-invitation
# 未配置模型和价格时没有付费生成能力。额度价与货币购买价格分别配置。
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
# 可用服务键：briefing、field-mapping、field-correction、field-suggestions、mail-parse；按实测成本定价。
SERVICE_PRICES={}
CREDIT_PACKS=[]
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=
PAYMENTS_LIVE=false
LIVE_LAUNCH_ACCEPTED=false

# 可选：仅用户明确选择的公开页面每日检查，默认关闭。
CLOUD_MONITORING_ENABLED=false
