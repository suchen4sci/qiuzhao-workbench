{
  "name": "qiuzhao-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "本地秋招资料与快速填表助手",
  "main": "src/main.cjs",
  "scripts": {
    "start": "node scripts/start.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "node tests/public-smoke.cjs",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg",
    "dist": "electron-builder"
  },
  "dependencies": {
    "imapflow": "2.2.1",
    "mailparser": "3.9.33",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.3.289",
    "playwright-core": "1.63.0"
  },
  "author": "Qiuzhao Workbench Contributors",
  "license": "MIT",
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.qiuzhao.workbench",
    "productName": "秋招工作台",
    "directories": {
      "output": "../release"
    },
    "files": [
      "src/**/*",
      "fixtures/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "../examples/demo-workspace",
        "to": "examples/demo-workspace"
      },
      {
        "from": "../templates/blank-workspace",
        "to": "templates/blank-workspace"
      },
      {
        "from": "../dashboard",
        "to": "dashboard",
        "filter": [
          "server.mjs",
          "lib/**/*",
          "public/**/*"
        ]
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    }
  }
}
